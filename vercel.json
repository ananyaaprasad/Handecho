{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "site/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/predict",
      "dest": "api/index.py"
    },
    {
      "src": "/dataset/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/",
      "dest": "/site/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/site/$1"
    }
  ]
}
